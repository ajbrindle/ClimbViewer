<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="50"
        android:background="@drawable/layout_border"
        android:orientation="vertical"
        android:baselineAligned="true"
        android:padding="8dp">

        <TextView
            android:id="@+id/panel1Label"
            style="@style/panelTitleStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL1" />

        <TextView
            android:id="@+id/txtPanel1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeMaxTextSize="60sp"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/oswald_bold"
            android:maxLines="1"
            android:text="8.88km"
            android:textSize="60sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="50"
        android:background="@drawable/layout_border"
        android:orientation="vertical"
        android:baselineAligned="true"
        android:padding="8dp">

        <TextView
            android:id="@+id/panel2Label"
            style="@style/panelTitleStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtPanel2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="60sp"
                android:autoSizeMinTextSize="28sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/oswald_bold"
                android:maxLines="1"
                android:text="888m"
                android:layout_weight="4"
                android:textSize="60sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/charge"
                android:layout_width="32dp"
                android:layout_height="51dp"
                android:layout_marginEnd="0dp"
                android:baselineAlignBottom="true"
                android:padding="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                app:tint="@color/reddish"
                android:src="@drawable/charge"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>