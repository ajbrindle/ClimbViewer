<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ClimbsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:id="@+id/layoutTitles">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtClimb"
            android:textSize="22sp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            android:padding="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/white"
            android:ellipsize="end"
            android:maxLines="1"
            android:minLines="1"
            android:singleLine="true"
            android:text="No climb selected"
            android:fontFamily="@font/oswald_bold"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/btnChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            app:icon="@drawable/list_items"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconPadding="0dp"
            android:text="" />
    </LinearLayout>

    <com.sk7software.climbviewer.view.ClimbView
        android:id="@+id/climbView"
        android:layout_width="match_parent"
        android:layout_height="350px"
        android:layout_below="@id/layoutTitles"
        android:layout_alignParentLeft="true"
        android:background="#00ffffff" />
    <TextView
        android:id="@+id/txtClimbDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_below="@+id/climbView"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:gravity="center"/>

    <LinearLayout
        android:id="@+id/climbButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtClimbDetails"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="0dp"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">
        <Button
            android:id="@+id/viewClimbBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            app:icon="@drawable/view"
            app:iconSize="20dp"
            app:iconGravity="start"
            app:iconTint="@color/white"
            app:iconPadding="2dp"
            android:text="View" />
        <Button
            android:id="@+id/deleteClimb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorError"
            app:icon="@drawable/delete"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconPadding="0dp"
            android:text=""/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/monitorClimbBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/climbButtons"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        android:textSize="24sp"
        app:icon="@drawable/monitor_climb"
        app:iconSize="34dp"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:iconPadding="2dp"
        android:text="Monitor Climbs"/>
    <ListView
        android:id="@+id/climbListSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:layout_below="@+id/climbButtons"
        android:visibility="invisible"/>

    <LinearLayout
        android:id="@+id/climbOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/monitorClimbBtn"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="15dp">

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screens to show for climbs"
            android:textSize="8pt"
            android:layout_marginStart="5dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swiMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:textSize="8pt"
            android:textColor="#000000"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="Bird's Eye" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swiClimb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:textSize="8pt"
            android:textColor="#000000"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="Parcours" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swiPursuit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:textSize="8pt"
            android:textColor="#000000"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="Poursuivant" />

    </LinearLayout>

</RelativeLayout>