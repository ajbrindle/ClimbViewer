<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".RoutesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal"
        android:id="@+id/layoutTitles">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtRoute"
            android:textSize="22sp"
            android:backgroundTint="@color/white"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            android:padding="4dp"
            android:layout_weight="1"
            android:background="#eeeeee"
            android:ellipsize="end"
            android:maxLines="1"
            android:minLines="1"
            android:singleLine="true"
            android:text="No route selected"
            android:fontFamily="@font/oswald_bold"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/btnChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            app:icon="@drawable/list_items"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconPadding="0dp"
            android:text="" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapView"
        android:name="com.sk7software.climbviewer.maps.MapFragment"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_below="@+id/layoutTitles"
        android:layout_above="@+id/allButtons"
        tools:layout="@layout/fragment_map"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/allButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/txtRouteDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="5dp"
            android:gravity="center"/>
        <LinearLayout
            android:id="@+id/routeButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/viewRouteBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                app:icon="@drawable/view"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconPadding="2dp"
                android:text="View" />
            <Button
                android:id="@+id/findClimbsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                app:icon="@drawable/find_climbs"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconPadding="2dp"
                android:text="Find Climbs"/>
            <Button
                android:id="@+id/deleteRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/colorError"
                app:icon="@drawable/delete"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconPadding="0dp"
                android:text=""/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/followRouteBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/routeButtons"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:textSize="24sp"
            app:icon="@drawable/follow_route"
            app:iconSize="32dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconPadding="2dp"
            android:text="Follow Route"/>
    </LinearLayout>
    <ListView
        android:id="@+id/routeListSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/allButtons"
        android:paddingTop="3dp"
        android:visibility="invisible"/>


</RelativeLayout>