<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginTop="15dp"
    android:orientation="vertical"
    android:keepScreenOn="false">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtSmoothDistance"
        android:text="Profile Smooth Distance: 50m"/>

    <SeekBar
        android:id="@+id/seekSmoothDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:max="255"
        android:min="0"
        android:progress="50" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtScreenDelay"
        android:layout_marginTop="10dp"
        android:text="Time Between Screens: 15s"/>

    <SeekBar
        android:id="@+id/seekScreenDelay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:max="60"
        android:min="10"
        android:progress="15" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtClimbWarn"
        android:layout_marginTop="10dp"
        android:text="Warn About Upcoming Climbs: 1000m"/>

    <SeekBar
        android:id="@+id/seekClimbWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:max="5000"
        android:min="0"
        android:progress="1000" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swiAutoMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto-monitor climbs on route" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swiClimbTolerance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assume climbs complete when started" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swiClimbSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sort climbs by rating" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swiVoicePrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play voice prompts" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swiSong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Spotify now playing" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtSongTime"
        android:layout_marginTop="5dp"
        android:text="Track Display Time: 30s"
        android:visibility="gone"/>

    <SeekBar
        android:id="@+id/seekSongTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:max="60"
        android:min="10"
        android:progress="30"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swiCadence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connect Cadence Sensor" />
        <Button
            android:id="@+id/btnCadenceSettings"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            app:icon="@drawable/gear_solid"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconPadding="0dp"
            android:layout_marginStart="5dp"
            android:text=""
            android:enabled="false"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtSensorName"
        android:text="Cadence Sensor Name"
        android:visibility="gone"/>

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Map Provider"
            android:layout_marginRight="8dp"/>
        <RadioButton
            android:id="@+id/radGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:checked="true"
            android:text="Google" />
        <RadioButton
            android:id="@+id/radMapBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MapBox" />
    </RadioGroup>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/btnMapBoxSettings"
        android:text="MapBox Settings"
        android:visibility="gone"/>
</LinearLayout>
